# Frontend - Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOYMENT=dev:your-project

# Open Router (AI categorization + security scanning; set in Convex dashboard for backend)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: Convex env SECURITY_SCAN_MODEL (e.g. google/gemini-2.0-flash-001) for cheaper scans

# GitHub token (Convex env GITHUB_TOKEN) for author sync + removed-skill detection; higher rate limits when set

# Google Analytics (optional)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Clerk Authentication (required for voting)
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Secret (set in Convex dashboard)
# CLERK_WEBHOOK_SECRET=whsec_...
