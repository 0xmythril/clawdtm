# Frontend - Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOYMENT=dev:your-project

# Open Router — set these in Convex dashboard (Settings → Environment Variables) for dev and prod
# Backend uses them for: security scanning only (categorization is keyword-based, no AI).
OPENROUTER_API_KEY=sk-or-v1-...

# Security scanner model (Convex env SECURITY_SCAN_MODEL). If unset, defaults to anthropic/claude-3.5-haiku (expensive).
# Recommended: use Gemini Flash for ~8x lower cost
SECURITY_SCAN_MODEL=google/gemini-2.0-flash-001
# Other cheap options: google/gemini-2.0-flash-lite-preview (even cheaper), anthropic/claude-3.5-haiku (better quality, higher cost)

# GitHub token (Convex env GITHUB_TOKEN) for author sync + removed-skill detection; higher rate limits when set
GITHUB_TOKEN=ghp_...

# Google Analytics (optional)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Clerk Authentication (required for voting)
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Webhook Secret (set in Convex dashboard)
# CLERK_WEBHOOK_SECRET=whsec_...
